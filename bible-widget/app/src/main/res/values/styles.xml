<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 카드 위의 작은 회색 제목 (예: "배경 색상") -->
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 둥근 카드 -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- 카드 안의 한 줄 선택지 (라디오/스위치) -->
    <style name="CardRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CardRowRadio" parent="CardRow">
        <item name="android:paddingStart">12dp</item>
    </style>

    <style name="CardRowSwitch" parent="CardRow">
        <item name="android:paddingStart">24dp</item>
    </style>

    <!-- 선택지 아래 설명 -->
    <style name="OptionDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">-8dp</item>
        <item name="android:paddingStart">56dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 카드 안 구분선 -->
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- 점이 찍힌 단계 슬라이더 (투명도, 글자 크기) -->
    <style name="StepSlider">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">20dp</item>
        <item name="android:maxHeight">20dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:progressDrawable">@drawable/seek_track</item>
        <item name="android:progressBackgroundTint">@color/seek_track</item>
        <item name="android:tickMark">@drawable/seek_tick</item>
        <item name="android:tickMarkTint">@color/seek_tick</item>
        <item name="android:thumb">@drawable/seek_thumb</item>
        <item name="android:thumbTint">@color/app_accent</item>
        <item name="android:splitTrack">false</item>
    </style>

    <!-- 아래쪽 "취소 / 저장" 글자 버튼 -->
    <style name="BottomBarButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
